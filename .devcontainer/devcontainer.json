{
  "name": "math-formula-game (devcontainer)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [5173],
  "postCreateCommand": "sudo chown -R vscode:vscode /workspace/node_modules || true && npm ci",
  "remoteUser": "vscode",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=${localWorkspaceFolderBasename}-node-modules,target=/workspace/node_modules,type=volume"
  ],
  "shutdownAction": "stopContainer"
}
